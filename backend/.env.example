# Local default: SQLite, no account required.
DATABASE_URL=sqlite+aiosqlite:///./lecturemap.db
# Production option: Supabase Postgres free tier https://supabase.com/pricing
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.project.supabase.co:5432/postgres

# File storage option: Supabase Storage free tier https://supabase.com/pricing
SUPABASE_URL=
# Server-side secret key only (Project Settings > API Keys > "sb_secret_...", or the legacy
# service_role key). The publishable/anon key cannot write to a private bucket and is refused.
# Never put this key in the frontend or in Vercel.
SUPABASE_KEY=
SUPABASE_BUCKET=lecture-files

# Knowledge graph option: Neo4j AuraDB Free https://neo4j.com/cloud/platform/aura-graph-database/
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Optional: database name (blank = server default), pool size and connect timeout (seconds)
NEO4J_DATABASE=
# NEO4J_MAX_POOL_SIZE=20
# NEO4J_CONNECTION_TIMEOUT=15

# Queue option: Upstash Redis free tier https://upstash.com/pricing
# Upstash: use the rediss:// (TLS) URL. Only read when USE_CELERY=true.
REDIS_URL=
USE_CELERY=false

# AI extraction: Google AI Studio free tier https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Auth
# Google OAuth: create a "Web application" client at https://console.cloud.google.com/apis/credentials
# and register this exact redirect URI for each environment:
#   development: http://localhost:8000/auth/google/callback
#   production:  https://<your-api-host>/auth/google/callback   (BACKEND_URL + /auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required (32+ random chars) when ENVIRONMENT=production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-production-secret
# Optional: separate secret for the OAuth session cookie (falls back to JWT_SECRET)
SESSION_SECRET=replace-with-a-long-random-production-secret
# Optional: encrypts users' own Gemini keys at rest (falls back to JWT_SECRET).
# Set it once before users save keys; rotating it makes saved keys unreadable.
KEY_ENCRYPTION_SECRET=

# App
# development (localhost):
#   ENVIRONMENT=development  FRONTEND_URL=http://localhost:5173  BACKEND_URL=http://localhost:8000
# production: both URLs must be public https:// URLs or the API refuses to start,
#   and interactive API docs are disabled.
# One .env can serve both: list entries comma separated, same order in both
# variables, e.g. FRONTEND_URL=http://localhost:5173,https://app.example.com
#                 BACKEND_URL=http://localhost:8000,https://api.example.com
# The entry whose host matches the request is used; production ignores non-https/localhost.
# Spell ENVIRONMENT exactly: development, production or test.
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Extra allowed browser origins, comma separated (FRONTEND_URL is always allowed;
# localhost dev origins are allowed only outside production)
CORS_ORIGINS=

# Gemini model and uploads
GEMINI_MODEL=gemini-3-flash-preview
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200
# Only set true if you accept storing uploads on local disk when Supabase is configured but failing
ALLOW_LOCAL_STORAGE_FALLBACK=false
GUEST_RETENTION_HOURS=48

# Security
RATE_LIMIT_ENABLED=true
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For (Render, nginx)
TRUST_PROXY_HEADERS=false
